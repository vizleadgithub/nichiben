SetEnvIf X-Forwarded-For "^124\.110\.209\.(0|1[0-9]|2[0-9]|[3-9][0-9]|10[0-9]|11[0-9]|12[0-7])"  allowed_access


SetEnvIf Request_URI ^/403\.html$ allowed_access

order deny,allow
deny from all
allow from env=allowed_access

ErrorDocument 403 /403.html
<Files "403.html">
    Require all granted
    Satisfy Any
</Files>

Options  FollowSymLinks SymLinksIfOwnerMatch

RewriteEngine on
RewriteRule ^403\.html$ - [L]

# ELBが付与するX-Forwarded-Protoヘッダを見てリダイレクト
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond $1 !^(info\.php|test\.php|index\.php|static|pma|alfproduct|js|css|jquery-ui|user_guide|.+\.gif$|.+\.jpg$|.+\.png$|.+\.js$)
RewriteRule ^(.*)$ /index.php/$1 [L]

