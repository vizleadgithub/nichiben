	<div>
このページはあなたが申込した研修の受講票をダウンロードすることができます。<br />
弁護士会主催研修は受講票を使用しない場合がありますので、ボタンが○色でない時はご所属の弁護士会にお問い合わせ下さい。
	</div>


<!--{if !empty($arr_list)}-->
	<div style="width:98.5%;" class="pager">
		<div style="text-align:left; float:left;width:245px;">
			<!--{$list_start|escape}-->～<!--{$list_end|escape}-->件を表示中（全<!--{$all_count|escape}-->件中）
		</div>
		<div style="text-align:right; float:right;width:245px;">
			<!--{$pager}-->
		</div>
	</div>




	<div style="width:100%;">
		<div style="text-align:right; float:right;width:245px;padding:5px;">
			<script type="text/javascript">
			<!--
			function select_pagemax(){
				location.href = "" + "?pagemax=" + document.form_pagemax.pagemax.options[document.form_pagemax.pagemax.selectedIndex].value;
			}
			// -->
			</script>
			<form name="form_pagemax">
			<select name="pagemax" onChange="select_pagemax()">
				<option value="5"<!--{if $page_max==5}--> selected=selected<!--{/if}-->>5</option>
				<option value="10"<!--{if $page_max==10}--> selected=selected<!--{/if}-->>10</option>
				<option value="20"<!--{if $page_max==20}--> selected=selected<!--{/if}-->>20</option>
				<option value="40"<!--{if $page_max==40}--> selected=selected<!--{/if}-->>40</option>
			</select>件ずつ表示
			</form>
		</div>
	</div>
	
	<table style="width:100%;" class="member_table" cellspacing="0" cellpadding="0">
		<tr>
			<th style="border:solid 1px #999999;background-color: #CEE6F6;padding:5px;text-align:center;">日付</th>
			<th style="border:solid 1px #999999;background-color: #CEE6F6;padding:5px;text-align:center;">講座名</th>
			<th style="border:solid 1px #999999;background-color: #CEE6F6;padding:5px;text-align:center;">単品価格</th>
			<th style="border:solid 1px #999999;background-color: #CEE6F6;padding:5px;text-align:center;">詳細</th>
			<th style="border:solid 1px #999999;background-color: #CEE6F6;padding:5px;text-align:center;">受講票</th>
		</tr>
		<!--{foreach from=$arr_list item=val}-->
		<tr>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;">研修日<br /><!--{$val.dates|escape}--></td>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;"><!--{$val.product_name|escape}--></td>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;" rowspan="2"><!--{$val.price|escape}-->円</td>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;" rowspan="2"><a href="/product/detail.php?pid=<!--{$val.product_id|escape}-->">詳細</a></td>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;" rowspan="2">
				<!--{if $val.ticket_flg == 1}-->
					発行済
				<!--{else}-->
					<script type="text/javascript">
						function non_download<!--{$val.order_detail_id|escape}-->() {
							document.getElementById('download_btn<!--{$val.order_detail_id|escape}-->').disabled = true;
							document.getElementById('download_div<!--{$val.order_detail_id|escape}-->').innerHTML = '発行済';
							window.open("ticket_download.php?odid=<!--{$val.order_detail_id|escape}-->", "", "width=10,height=10");
						}
					</script>
					<div id="download_div<!--{$val.order_detail_id|escape}-->">
						<a id="download_btn<!--{$val.order_detail_id|escape}-->" href="javascript: void(0);" onclick="non_download<!--{$val.order_detail_id|escape}-->();" >発行</a>
					</div>
				<!--{/if}-->
			</td>
		</tr>
		<tr>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;">購入手続完了日<br /><!--{if $val.payment_status=='2'}--><!--{$val.payment_date|escape}--><!--{else}-->-<!--{/if}--></td>
			<td style="border:solid 1px #999999;padding:5px;text-align:center;vertical-align:middle;">会名：<!--{$val.name|escape}--><br />会場：<!--{$val.hall|escape}--></td>
		</tr>
		<!--{/foreach}-->
	</table>
	
<!--{else}-->
	該当する動画はありません。
<!--{/if}-->
</div>