			<!--{/if}-->
		</div>
		<div style="float:right;width:500px;text-align:center;">
			<div style="float:left;width:380px; border: solid 0px #000000;height:100%;">
				<table>
					<tr>
						<th colspan="2" style="text-align:left;vertical-align:top;"><a href="./../product/detail.php?pid=<!--{$row.product_id|escape}-->"><!--{$row.product_name|escape}--></a></th>
