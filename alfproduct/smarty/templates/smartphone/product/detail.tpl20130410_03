<script type="text/javascript">
<!--{* 動画の読み込みを遅延させるスクリプト(プレイヤー側が同時読み込みに非対応のため) *}-->
<!--{if !empty($arr_player_iframe)}-->
	var loop = 0;
	var iframe_html = new Array();
	<!--{foreach name=player_iframe_js from=$arr_player_iframe item=player_iframe}-->
	iframe_html[<!--{$smarty.foreach.player_iframe_js.index}-->] = '<!--{$player_iframe}-->';
	<!--{/foreach}-->

	function printIFrame(){
		document.getElementById('iframe' + loop).innerHTML = iframe_html[loop];
		if(loop < <!--{$player_iframe_count}-->-1){
			loop += 1;
			setTimeout("printIFrame()",2000);
		}
	}
	window.onload=printIFrame();
<!--{/if}-->

function playerFormSubmit(vid,ftn,view_btn){
    window.open("about:blank","playerDisp","width=670,height=650,menubar=no,toolbar=no,scrollbars=yes");
    document.getElementById("hid_vid").value = vid;
    document.getElementById("hid_ftn").value = ftn;
    document.getElementById("hid_view_btn").value = view_btn;
    document.playerForm.target = "playerDisp";
    document.playerForm.method = "post";
    document.playerForm.action = "/player/index.php?term=pc";
    document.playerForm.submit();
}
function downloadFormSubmit(cdname){
    document.getElementById("hid_cdname").value = cdname;
    document.downloadForm.method = "post";
    document.downloadForm.action = "download.php";
    document.downloadForm.submit();
}
$(window).unload(printIFrame());
window.onunload = function(){printIFrame();}

</script>

<script type="text/javascript">

/**
 * Simple Rollover[single]
 * @license The MIT License
 */
window.onload =function(){
    var myImg = document.getElementById("thumb").getElementsByTagName("img");
    var regrep = "&width=45&height=45";
    var newimg = new Array();
    for (var i = 0; i <myImg.length; i++) {
        newimg[i] = new Image();
        newimg[i].src = myImg[i].src;
        myImg[i].onmouseover =function() {
            var href = this.src.replace(regrep,"&width=180&height=135");
                document.getElementById('rollover_view').src=href;
        }
    }
}
</script>