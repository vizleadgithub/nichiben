<!--{* 資料ダウンロードボタン用form *}-->
<form name="downloadForm" action="#" method="post">
<input type="hidden" name="pid" value="<!--{$pid}-->" />
<input type="hidden" name="cdname" id="hid_cdname" value="" />
</form>

<script type="text/javascript">
<!--{* 動画の読み込みを遅延させるスクリプト(プレイヤー側が同時読み込みに非対応のため) *}-->
<!--{*
<!--{if !empty($arr_player_iframe)}-->
	var loop = 0;
	var iframe_html = new Array();
	<!--{foreach name=player_iframe_js from=$arr_player_iframe.frame item=player_iframe}-->
	iframe_html[<!--{$smarty.foreach.player_iframe_js.index}-->] = '<!--{$player_iframe}-->';
	<!--{/foreach}-->

	function printIFrame(){
		if (jsIsset(iframe_html[loop])){
			document.getElementById('iframe' + loop).innerHTML = iframe_html[loop];
			if(loop < <!--{$player_iframe_count}-->){
				loop += 1;
				setTimeout("printIFrame()",2000);
			}
		}
	}
	function jsIsset( data ){
	    return ( typeof( data ) != 'undefined' );
	}
	window.onLoad=printIFrame();
<!--{/if}-->
*}-->

function playerFormSubmit(vid,ftn,ccno,view_btn){
    window.open("about:blank","playerDisp","width=675,height=660,menubar=no,toolbar=no,scrollbars=yes,resizable=yes");
<!--{*
    <!--{if !empty($arr_player_iframe)}-->
    <!--{foreach name=player_iframe_frame_no from=$arr_player_iframe.frame_no item=player_iframe_frame_no}-->
    document.getElementById('playerFrame<!--{$player_iframe_frame_no}-->').contentWindow.ak_pause();
    <!--{/foreach}-->
    <!--{/if}-->
*}-->
    document.getElementById("hid_vid").value = vid;
    document.getElementById("hid_ftn").value = ftn;
    document.getElementById("hid_ccno").value = ccno;
    document.getElementById("hid_view_btn").value = view_btn;
    document.playerForm.target = "playerDisp";
    document.playerForm.method = "post";
    document.playerForm.action = "/player/index.php?term=pc";
    document.playerForm.submit();
}
function playerEthicFormSubmit(vid,ftn,ccno,view_btn){
    window.open("about:blank","playerDisp","width=675,height=660,menubar=no,toolbar=no,scrollbars=yes,resizable=yes");
    document.getElementById("hid_vid").value = vid;
    document.getElementById("hid_ftn").value = ftn;
    document.getElementById("hid_ccno").value = ccno;
    document.getElementById("hid_view_btn").value = view_btn;
    document.playerForm.target = "playerDisp";
    document.playerForm.method = "post";
    document.playerForm.action = "/player/player_ethic.php?term=pc";
    document.playerForm.submit();
}
function downloadFormSubmit(cdname){
    document.getElementById("hid_cdname").value = cdname;
    document.downloadForm.method = "post";
    document.downloadForm.action = "download.php?PHPSESSID=<!--{php}-->echo session_id();<!--{/php}-->";
    document.downloadForm.submit();
}
function downloadPopup(){
    window.open("about:blank","documentDisp","width=675,height=800,menubar=no,toolbar=no,scrollbars=yes,resizable=yes");
    document.downloadForm.target = "documentDisp";
    document.downloadForm.method = "post";
    document.downloadForm.action = "document.php?PHPSESSID=<!--{php}-->echo session_id();<!--{/php}-->";
    document.downloadForm.submit();
}

<!--{*
<!--{if !empty($arr_player_iframe)}-->
$(window).unload(printIFrame());
window.onunload = function(){printIFrame();}
<!--{/if}-->
*}-->
</script>

